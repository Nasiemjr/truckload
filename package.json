{
  "name": "template-mux-vite",
  "description": "Wanna build a Vite + TanStack Router app at Mux? Starting here's not a bad idea.",
  "version": "1.0.0",
  "author": "Mux DevEx <devex@mux.com>",
  "private": true,
  "packageManager": "bun@1.3.5",
  "scripts": {
    "dev": "node init && vite dev",
    "build": "node init && vite build",
    "start": "node init && bun .output/server/index.mjs",
    "lint": "prettier --check ./ && eslint .",
    "format": "prettier --write ./ && eslint . --fix",
    "prepare": "husky install",
    "partykit": "partykit dev",
    "workflow:web": "bunx workflow web",
    "workflow:inspect": "bunx workflow inspect runs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "start:dev": "node init && concurrently -c \"white,red\" --names \"VITE,PARTYKIT\" \"bun run dev\" \"bun run partykit\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.515.0",
    "@aws-sdk/s3-request-presigner": "^3.515.0",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@mux/mux-node": "^10.1.0",
    "@tanstack/react-router": "^1.170.17",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "clsx": "^2.1.0",
    "husky": "^8.0.3",
    "immer": "^10.0.4",
    "partysocket": "1.0.0",
    "prettier": "^3.2.5",
    "pretty-quick": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "workflow": "^4.2.4",
    "zod": "^3.22.4",
    "zustand": "^4.5.1"
  },
  "devDependencies": {
    "@redux-devtools/extension": "^3.3.0",
    "@tailwindcss/forms": "^0.5.7",
    "@tanstack/router-plugin": "^1.168.19",
    "@types/node": "^22.20.0",
    "@types/react": "18.2.15",
    "@types/react-dom": "18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@workflow/vitest": "^4.0.5",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^5.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^3.0.0",
    "nitro": "^3.0.0",
    "nock": "^14.0.15",
    "partykit": "0.0.93",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.1"
  },
  "trustedDependencies": [
    "@swc/core"
  ]
}
